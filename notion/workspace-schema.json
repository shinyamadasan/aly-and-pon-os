    { "area": "Decision Log", "businessOwner": "Business" }
  ],
  "operatingPrinciples": {
    "name": "Aly & Pon Operating Principles",
    "scope": "These principles primarily guide the Business Knowledge Base, but they also define the boundaries between the Business Knowledge Base, Product Lab App, and Git repository.",
    "purpose": "The Business Knowledge Base exists to preserve and organize Aly & Pon's business knowledge. It is not an operational system.",
    "principles": [
      {
        "name": "Single Source of Truth",
        "statement": "Each type of information has exactly one owner.",
        "ownership": [
          { "information": "Brand strategy", "owner": "Notion" },
          { "information": "Product positioning", "owner": "Notion" },
          { "information": "Content planning", "owner": "Notion" },
          { "information": "Business decisions", "owner": "Notion" },
          { "information": "Inventory", "owner": "Product Lab App" },
          { "information": "Recipes", "owner": "Product Lab App" },
          { "information": "Costing", "owner": "Product Lab App" },
          { "information": "Purchases", "owner": "Product Lab App" },
          { "information": "Production", "owner": "Product Lab App" },
          { "information": "Sales", "owner": "Product Lab App" },
          { "information": "Code", "owner": "Git" },
          { "information": "Knowledge base schema", "owner": "Git" }
        ]
      },
      {
        "name": "One Purpose Per Page",
        "statement": "Every page must answer one clear question. If a page serves multiple unrelated purposes, it should be split or simplified.",
        "examples": [
          { "page": "Brand Bible", "question": "Who are we?" },
          { "page": "Product Catalog entry", "question": "What are we selling?" },
          { "page": "Content Library entry", "question": "How are we communicating it?" },
          { "page": "Decision Log entry", "question": "Why did we change?" }
        ]
      },
      {
        "name": "Knowledge Over Operations",
        "statement": "Notion stores ideas, strategy, documentation, decisions, positioning, and content knowledge. Notion does not store inventory, recipes, production, costing, purchasing, or daily operations."
      },
      {
        "name": "Simplicity Wins",
        "statement": "When choosing between adding another database or improving an existing page, prefer improving the existing page unless there is a recurring need for database behavior."
      },
      {
        "name": "Relationships Explain Context",
        "statement": "Relations should answer why a product changed, why a series was created, or which decision changed a product. Relations should improve understanding, not recreate operational workflows."
      },
      {
        "name": "Grow Only When Necessary",
        "statement": "Do not build for future possibilities. Add pages, databases, and automation only after recurring work demonstrates the need."
      },
      {
        "name": "Document Decisions, Not Conversations",
        "statement": "Do not preserve raw discussions by default. Preserve conclusions."
      }
    ]
  },
  "statusSystems": {
    "catalogStatus": ["Draft", "Active", "Retired"],
    "contentStatus": ["Idea", "Draft", "Ready", "Scheduled", "Published"],
    "decisionStatus": ["Proposed", "Approved", "Rejected", "Superseded"],
    "contentType": ["Photo", "Reel", "Carousel", "Story", "Caption", "Blog", "Email"]
  },
  "databases": [
    {
      "name": "Product Catalog",
      "phase": "Business Knowledge Base v1",
      "purpose": "Brand-facing product documentation.",
      "businessOwner": "Product",
      "pageSections": [
        "Story",
        "Selling Points",
        "Customer Experience",
        "Marketing Ideas",
        "Related Decisions"
      ],
      "properties": [
        { "name": "Product", "type": "title", "required": true },
        { "name": "Category", "type": "select", "required": false, "options": ["Coffee", "Bakery", "Seasonal", "Merchandise"] },
        { "name": "Status", "type": "select", "required": true, "optionsRef": "catalogStatus" },
        { "name": "Hero Image", "type": "files", "required": false },
        { "name": "Short Description", "type": "rich_text", "required": false },
        { "name": "Positioning", "type": "rich_text", "required": false },
        { "name": "Launch Date", "type": "date", "required": false },
        { "name": "Featured", "type": "checkbox", "required": false },
        { "name": "Related Decisions", "type": "relation", "required": false, "relatedDatabase": "Decision Log", "cardinality": "zero_or_many" }
      ]
    },
    {
      "name": "Content Library",
      "phase": "Business Knowledge Base v1",
      "purpose": "Content planning and reusable content knowledge.",
      "businessOwner": "Marketing",
      "workflow": ["Idea", "Draft", "Ready", "Scheduled", "Published"],
      "properties": [
        { "name": "Title", "type": "title", "required": true },
        { "name": "Platform", "type": "select", "required": false, "options": ["Instagram", "Facebook", "TikTok", "Website", "Email", "Print"] },
        { "name": "Content Type", "type": "select", "required": true, "optionsRef": "contentType" },
        { "name": "Related Product", "type": "relation", "required": false, "relatedDatabase": "Product Catalog", "cardinality": "zero_or_many" },
        { "name": "Status", "type": "select", "required": true, "optionsRef": "contentStatus" },
        { "name": "Publish Date", "type": "date", "required": false },
        { "name": "Series", "type": "rich_text", "required": false },
        { "name": "Related Decisions", "type": "relation", "required": false, "relatedDatabase": "Decision Log", "cardinality": "zero_or_many" }
      ]
    },
    {
      "name": "Decision Log",
      "phase": "Business Knowledge Base v1",
      "purpose": "Durable business memory.",
      "businessOwner": "Business",
      "properties": [
        { "name": "Decision", "type": "title", "required": true },
        { "name": "Area", "type": "select", "required": false, "options": ["Brand", "Product", "Marketing", "Business", "Architecture"] },
        { "name": "Date", "type": "date", "required": false },
        { "name": "Status", "type": "select", "required": true, "optionsRef": "decisionStatus" },
        { "name": "Reason", "type": "rich_text", "required": false },
        { "name": "Related Product", "type": "relation", "required": false, "relatedDatabase": "Product Catalog", "cardinality": "zero_or_many" },
        { "name": "Related Content", "type": "relation", "required": false, "relatedDatabase": "Content Library", "cardinality": "zero_or_many" }
      ]
    }
  ],
  "relationships": [
    { "from": "Content Library.Related Product", "to": "Product Catalog", "cardinality": "zero_or_many" },
    { "from": "Decision Log.Related Product", "to": "Product Catalog", "cardinality": "zero_or_many" },
    { "from": "Decision Log.Related Content", "to": "Content Library", "cardinality": "zero_or_many" },
    { "from": "Product Catalog.Related Decisions", "to": "Decision Log", "cardinality": "zero_or_many" },
    { "from": "Content Library.Related Decisions", "to": "Decision Log", "cardinality": "zero_or_many" }
  ],
  "explicitExclusions": [
    "CRM",
    "Finance",
    "Inventory",
    "Recipes",
    "Suppliers",
    "Projects",
    "Tasks",
    "Operations",
    "Website CMS",
    "SEO management",
    "Employee management",
    "Production"
  ],
  "assumptions": [
    "The Brand Bible remains one canonical document and should not be split into many pages.",
    "Series remains a lightweight content grouping, not a campaign management system.",
    "Product Catalog entries use structured sections instead of a generic notes field.",
    "The Product Lab App remains the operational source of truth.",
    "Git remains the source of truth for schemas, automation, and code."
  ],
  "integrationStatus": {
    "notionApiCode": true,
    "dependenciesInstalled": false,
    "workspaceTouched": false,
    "seedDataApproved": false
  },
  "safetyRules": [
    "Never delete or archive Notion content automatically.",
    "Dry-run is the default for write-capable commands.",
    "Live writes require an explicit --apply flag.",
    "Never expose secrets.",
    "Operations must be idempotent.",
    "Stop on unexpected live-schema conflicts.",
    "Seed data is not approved unless explicitly marked approved."
  ]
}
