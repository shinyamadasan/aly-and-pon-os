    "business": "Aly & Pon",
    "summary": "A Notion-based business knowledge base that preserves brand strategy, product positioning, content knowledge, and business decisions without becoming an operational system.",
    "guidingRule": "The app runs the business. Notion explains the business. Git preserves the system."
  },
  "home": {
    "name": "Home",
    "sections": [
      "Mission",
      "Quick Links",
      "Current Priorities",
      "Recent Product Catalog entries",
      "Recent Decision Log entries",
      "How to use this knowledge base"
    ]
  },
  "brand": {
    "name": "Brand",
    "businessOwner": "Brand",
    "pages": [
      "Brand Bible",
      "Inspiration",
      "Visual Identity",
      "Packaging"
    ],
    "brandBibleMetadata": {
      "version": "1.0",
      "lastUpdated": "2026-07-28",
      "owner": "Aly & Pon"
    }
  },
  "businessOwnership": [
    { "area": "Brand", "businessOwner": "Brand" },
